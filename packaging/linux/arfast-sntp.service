[Unit]
Description=AR Fast SNTP Linux clock synchronization
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/arfast-sntp
ExecStart=/opt/arfast-sntp/worker/ARFastSNTP.Linux --daemon
Restart=on-failure
RestartSec=2
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/arfast-sntp
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=CAP_SYS_TIME
AmbientCapabilities=CAP_SYS_TIME

[Install]
WantedBy=multi-user.target
