<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ARFastSNTP.Studio.MainWindow"
        Title="AR Fast SNTP" Width="960" Height="440"
        MinWidth="850" MinHeight="415"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ArBrush.Canvas}"
        FontFamily="{DynamicResource ArFont.Inter}">
  <!-- Content-sized sections: one source never creates an empty table viewport. -->
  <Grid Margin="20,14,20,16" RowDefinitions="34,96,Auto,Auto" RowSpacing="11">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="9">
        <Viewbox Width="19" Height="19">
          <Path Width="960" Height="960" Stretch="Uniform"
                Data="M636-848.5Q709-817 763-763t85.5 127Q880-563 880-480v11q-19-13-39-23t-42-17q-8-89-61-161.5T600-776v16q0 33-23.5 56.5T520-680h-80v80q0 17-11.5 28.5T400-560h-80v80h257q-62 37-99.5 100.5T440-240q-33 0-56.5-23.5T360-320v-40L168-552q-3 18-5.5 36t-2.5 36q0 125 83 216.5T451-161q7 23 17 42.5T491-80h-11q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5Zm-57.5 750Q520-157 520-240t58.5-141.5Q637-440 720-440t141.5 58.5Q920-323 920-240T861.5-98.5Q803-40 720-40T578.5-98.5ZM786-146l28-28-74-74v-112h-40v128l86 86Z" Fill="{DynamicResource ArBrush.Success}"/>
        </Viewbox>
        <TextBlock Text="AR Fast SNTP" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                  VerticalAlignment="Center">
        <TextBlock x:Name="GlobalLamp" Text="●" FontSize="12"
                   Foreground="{DynamicResource ArBrush.TextDim}"/>
        <TextBlock x:Name="GlobalStatus" Text="Checking service" Classes="muted"
                   VerticalAlignment="Center"/>
      </StackPanel>
      <Button Grid.Column="2" Classes="ar" Width="32" Height="30" Padding="5"
              Background="Transparent" BorderThickness="0"
              Click="Refresh_OnClick" ToolTip.Tip="Refresh now">
        <Viewbox Width="17" Height="17">
          <Path Width="24" Height="24" Stretch="Uniform"
                Data="M20 11a8 8 0 0 0-14.5-5.5L3 8 M3 3v5h5 M4 13a8 8 0 0 0 14.5 5.5L21 16 M21 21v-5h-5"
                Stroke="{DynamicResource ArBrush.TextSecondary}"
                StrokeThickness="1.8" StrokeLineCap="Round"/>
        </Viewbox>
      </Button>
    </Grid>

    <!-- A single calm summary strip; no border around each metric. -->
    <Border Grid.Row="1" Background="{DynamicResource ArBrush.Surface1}"
            CornerRadius="10" Padding="17,12">
      <Grid ColumnDefinitions="1*,1*" ColumnSpacing="23">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Text="PC TIME  ·  LOCAL" Classes="micro"/>
          <TextBlock x:Name="PcClock" Grid.Row="1" Text="--:--:--"
                     FontSize="31" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="PcDate" Grid.Row="2" Classes="muted" Text="—"/>
        </Grid>
        <Border Grid.Column="1" BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource ArBrush.Stroke}" Padding="22,0,0,0">
          <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Text="PC SYNC STATUS" Classes="micro"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Spacing="9">
              <TextBlock x:Name="SyncLamp" Text="●" FontSize="16"
                         Foreground="{DynamicResource ArBrush.TextDim}"/>
              <TextBlock x:Name="SyncState" Text="Checking"
                         FontSize="21" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="SyncDetail" Grid.Row="2" Classes="muted"
                       Text="Checking NTP connection..."
                       TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- The number of displayed rows determines the list height. -->
    <Border Grid.Row="2" Background="{DynamicResource ArBrush.Surface1}"
            CornerRadius="10" Padding="14,11,14,12">
      <Grid RowDefinitions="29,33,51,27">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <TextBlock Text="NTP Servers" FontSize="14" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="ListCount" Grid.Column="1"
                     Classes="micro" Text="1 server" VerticalAlignment="Center"/>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource ArBrush.Surface2}"
                CornerRadius="5" Padding="11,0">
          <Grid ColumnDefinitions="32,55,*,102,69,109,131,79" ColumnSpacing="4">
            <TextBlock Text="#" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Use" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="NTP Server IP" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Status" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="Stratum" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="Offset" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="SERVER TIME" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="7" Text="Broadcast" Classes="micro" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="11,0"
              ColumnDefinitions="32,55,*,102,69,109,131,79" ColumnSpacing="4">
          <TextBlock Text="01" Classes="muted" VerticalAlignment="Center"/>
          <!-- Actual service switch, not the tiny material glyph scaled down. -->
          <Button x:Name="SourceToggle" Grid.Column="1" Width="47" Height="34"
                  Padding="0" BorderThickness="0" Background="Transparent"
                  Click="ToggleSource_OnClick"
                  ToolTip.Tip="Enable / disable NTP service">
            <Border x:Name="SourceTrack" Width="43" Height="24"
                    CornerRadius="12" Background="{DynamicResource ArBrush.StrokeStrong}">
              <Grid Margin="3,0">
                <Ellipse x:Name="SourceThumb" Width="18" Height="18"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Fill="{DynamicResource ArBrush.Text}"/>
              </Grid>
            </Border>
          </Button>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center">
            <Viewbox Width="17" Height="17">
              <Path Width="960" Height="960" Stretch="Uniform"
                    Data="M636-848.5Q709-817 763-763t85.5 127Q880-563 880-480v11q-19-13-39-23t-42-17q-8-89-61-161.5T600-776v16q0 33-23.5 56.5T520-680h-80v80q0 17-11.5 28.5T400-560h-80v80h257q-62 37-99.5 100.5T440-240q-33 0-56.5-23.5T360-320v-40L168-552q-3 18-5.5 36t-2.5 36q0 125 83 216.5T451-161q7 23 17 42.5T491-80h-11q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5Zm-57.5 750Q520-157 520-240t58.5-141.5Q637-440 720-440t141.5 58.5Q920-323 920-240T861.5-98.5Q803-40 720-40T578.5-98.5ZM786-146l28-28-74-74v-112h-40v128l86 86Z" Fill="{DynamicResource ArBrush.TextSecondary}"/>
            </Viewbox>
            <TextBlock x:Name="PeerAddress" Text="—" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock x:Name="PeerHealth" Grid.Column="3" Text="—"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="PeerStratum" Grid.Column="4" Text="—"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="PeerOffset" Grid.Column="5" Text="—"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="PeerClock" Grid.Column="6" Text="—"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="PeerBroadcast" Grid.Column="7" Text="—"
                     VerticalAlignment="Center"
                     ToolTip.Tip="Broadcast listening is not yet supported."/>
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="9,2,9,0">
          <TextBlock x:Name="ConnectionHint" Text="Checking server connection..."
                     Classes="muted" TextTrimming="CharacterEllipsis"
                     FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="LastReply" Grid.Column="1" Text="—"
                     Classes="micro" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
    </Border>

    <StackPanel Grid.Row="3" Spacing="7">
      <Button Classes="ar" Background="Transparent" BorderThickness="0"
              Padding="4,7" HorizontalContentAlignment="Stretch"
              Click="History_OnClick"
              ToolTip.Tip="Show or hide synchronization events">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
          <Viewbox Width="20" Height="20">
            <Path x:Name="HistoryChevron" Width="960" Height="960"
                  Stretch="Uniform" Data="m480-340 180-180-57-56-123 123-123-123-57 56 180 180Zm0 260q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"
                  Fill="{DynamicResource ArBrush.TextSecondary}"/>
          </Viewbox>
          <TextBlock Grid.Column="1" Text="Status History"
                     VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBlock x:Name="EventCount" Grid.Column="2" Text="0 events"
                     Classes="micro" VerticalAlignment="Center"/>
        </Grid>
      </Button>
      <ScrollViewer x:Name="HistoryScroll" IsVisible="False"
                    MaxHeight="132" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="HistoryEvents" Margin="12,0,6,8" Spacing="7"/>
      </ScrollViewer>
    </StackPanel>
  </Grid>
</Window>
