<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ARFastSNTP.Studio.MainWindow"
        Title="AR Fast SNTP"
        Width="1020" Height="510"
        MinWidth="900" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ArBrush.Canvas}"
        FontFamily="{DynamicResource ArFont.Inter}">
  <Grid Margin="18" RowDefinitions="44,100,*,Auto" RowSpacing="12">
    <!-- One calm navigation line. No installer or diagnostic prose in the monitor. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
      <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
        <Viewbox Width="19" Height="19">
          <Path Width="24" Height="24" Stretch="Uniform"
                Data="M12 8v4l3 2 M12 22a10 10 0 1 0 0-20a10 10 0 0 0 0 20z"
                Stroke="{DynamicResource ArBrush.Success}" StrokeThickness="1.8"
                StrokeLineCap="Round"/>
        </Viewbox>
        <TextBlock Classes="section" Text="AR Fast SNTP" VerticalAlignment="Center"/>
      </StackPanel>
      <Border Grid.Column="1" CornerRadius="{DynamicResource ArRadius.MD}"
              Background="{DynamicResource ArBrush.Surface2}"
              Padding="12,7" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <TextBlock x:Name="GlobalLamp" Text="●" Foreground="{DynamicResource ArBrush.TextDim}"/>
          <TextBlock x:Name="GlobalStatus" Text="Checking..." FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
      <Button Grid.Column="2" Classes="ar" Width="36" Padding="4"
              Click="Refresh_OnClick" ToolTip.Tip="Refresh current service status">
        <Viewbox Width="17" Height="17">
          <Path Width="24" Height="24" Stretch="Uniform"
                Data="M20 11a8 8 0 0 0-14.5-5.5L3 8 M3 3v5h5 M4 13a8 8 0 0 0 14.5 5.5L21 16 M21 21v-5h-5"
                Stroke="{DynamicResource ArBrush.Text}" StrokeThickness="1.8"
                StrokeLineCap="Round"/>
        </Viewbox>
      </Button>
    </Grid>

    <!-- Information-first: PC date and actual synchronization are dominant. -->
    <Grid Grid.Row="1" ColumnDefinitions="1.12*,1*" ColumnSpacing="12">
      <Border Classes="panel" Padding="15,11">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Text="PC TIME  ·  UTC" Classes="micro"/>
          <TextBlock x:Name="PcClock" Grid.Row="1" Text="--:--:--"
                     FontSize="30" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="PcDate" Grid.Row="2" Classes="muted" Text="—"/>
        </Grid>
      </Border>
      <Border Classes="panel" Grid.Column="1" Padding="15,11">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Text="PC SYNCHRONIZATION" Classes="micro"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center">
            <TextBlock x:Name="SyncLamp" Text="●" FontSize="18"
                       Foreground="{DynamicResource ArBrush.TextDim}"/>
            <TextBlock x:Name="SyncState" Text="Checking..."
                       FontSize="21" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock x:Name="SyncDetail" Grid.Row="2" Classes="muted"
                     TextTrimming="CharacterEllipsis" Text="Waiting for service"/>
        </Grid>
      </Border>
    </Grid>

    <!-- One real row until multi-peer worker/configuration is implemented.
         No disabled Add Server, inert toggles or simulated NTP values. -->
    <Border Grid.Row="2" Classes="panel" Padding="12,12,12,14">
      <Grid RowDefinitions="30,34,56,*,Auto" RowSpacing="5">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="NTP Servers" Classes="section" VerticalAlignment="Center"/>
          <TextBlock x:Name="ListCount" Grid.Column="1" Classes="micro"
                     VerticalAlignment="Center" Text="1 source"/>
        </Grid>
        <Border Grid.Row="1" CornerRadius="{DynamicResource ArRadius.SM}"
                Background="{DynamicResource ArBrush.Surface2}" Padding="10,0">
          <Grid ColumnDefinitions="38,48,*,92,70,112,155,83" ColumnSpacing="7">
            <TextBlock Text="#" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Use" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Server" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Status" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="Stratum" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="Offset" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="Server UTC" Classes="micro" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="7" Text="Broadcast" Classes="micro" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Border Grid.Row="2" Classes="table-row" Padding="10,0">
          <Grid ColumnDefinitions="38,48,*,92,70,112,155,83" ColumnSpacing="7">
            <TextBlock Text="01" Classes="muted" VerticalAlignment="Center"/>
            <TextBlock x:Name="EnabledState" Grid.Column="1" Text="—"
                       VerticalAlignment="Center" Foreground="{DynamicResource ArBrush.TextDim}"
                       ToolTip.Tip="Current source used by the Windows Service"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7"
                        VerticalAlignment="Center">
              <Viewbox Width="16" Height="16">
                <Path Width="24" Height="24" Stretch="Uniform"
                      Data="M4 4h16v6H4z M4 14h16v6H4z M8 7h.01 M8 17h.01"
                      Stroke="{DynamicResource ArBrush.TextSecondary}" StrokeThickness="1.75"
                      StrokeLineCap="Round"/>
              </Viewbox>
              <TextBlock x:Name="PeerAddress" Text="—" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock x:Name="PeerHealth" Grid.Column="3" Text="—"
                       VerticalAlignment="Center" Classes="muted"/>
            <TextBlock x:Name="PeerStratum" Grid.Column="4" Text="—"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="PeerOffset" Grid.Column="5" Text="—"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PeerClock" Grid.Column="6" Text="—"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="PeerBroadcast" Grid.Column="7" Text="—"
                       VerticalAlignment="Center"
                       ToolTip.Tip="Only unicast SNTP is measured; broadcast remains unknown."/>
          </Grid>
        </Border>
        <Border Grid.Row="4" BorderBrush="{DynamicResource ArBrush.Stroke}"
                BorderThickness="0,1,0,0" Padding="2,8,2,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="ConnectionHint" Classes="muted"
                       TextTrimming="CharacterEllipsis" Text="Checking SNTP connection..."/>
            <TextBlock x:Name="LastReply" Grid.Column="1" Classes="micro" Text="—"/>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- Collapsed by default. A Lucide chevron gives a visible affordance. -->
    <Border Grid.Row="3" Classes="panel" Padding="12">
      <StackPanel Spacing="8">
        <Button x:Name="HistoryToggle" Classes="ar" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" Click="History_OnClick">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Viewbox Width="16" Height="16">
              <Path x:Name="HistoryChevron" Width="24" Height="24"
                    Stretch="Uniform" Data="M9 18l6-6-6-6"
                    Stroke="{DynamicResource ArBrush.TextSecondary}"
                    StrokeThickness="2" StrokeLineCap="Round"/>
            </Viewbox>
            <TextBlock Grid.Column="1" Text="Status history"
                       VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock x:Name="EventCount" Grid.Column="2" Classes="micro"
                       VerticalAlignment="Center" Text="0 events"/>
          </Grid>
        </Button>
        <ScrollViewer x:Name="HistoryScroll" IsVisible="False"
                      MaxHeight="140" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="HistoryEvents" Spacing="6" Margin="8,2,8,6">
            <TextBlock Classes="muted" Text="No correction events yet."/>
          </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>
</Window>
