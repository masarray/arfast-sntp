<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Canonical icon (do not duplicate binary resources across projects). -->
    <ApplicationIcon>../../assets/favicon/favicon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>ARFastSNTP.Studio</AssemblyName>
    <RootNamespace>ARFastSNTP.Studio</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../assets/favicon/favicon.ico" Link="Assets/brand.ico" />
    <AvaloniaResource Include="../../assets/favicon/favicon-32x32.png" Link="Assets/brand.png" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <Compile Include="../ARFastSNTP.Dashboard/DashboardStatus.cs" Link="Interop/DashboardStatus.cs" />
    <Compile Include="../ARFastSNTP/SourceControlProtocol.cs" Link="Interop/SourceControlProtocol.cs" />
    <Compile Include="../ARFastSNTP/NtpPeer.cs" Link="Interop/NtpPeer.cs" />
    <Compile Include="../ARFastSNTP/PeerControlProtocol.cs" Link="Interop/PeerControlProtocol.cs" />
  </ItemGroup>
</Project>
